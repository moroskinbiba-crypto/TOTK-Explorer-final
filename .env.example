# Telegram
# Never commit this value to Git.
TELEGRAM_BOT_TOKEN=
# Telegram numeric user ID of the owner/admin who controls the bot via its private chat.
TELEGRAM_ADMIN_IDS=

# Telegram Business
# auto = reply to customers immediately
# suggest = generate a draft and ask the owner to approve/reject it
# off = do not auto-reply
AUTO_REPLY_ENABLED=true
AUTO_REPLY_MODE=auto

# Optional customer-chat filters. Comma-separated Telegram chat IDs.
# When allowlist is non-empty, only listed chats are processed.
BUSINESS_CHAT_ALLOWLIST=
BUSINESS_CHAT_BLOCKLIST=

# Keep false unless you explicitly want the bot to answer ordinary messages
# sent directly to the bot's own private chat.
ENABLE_PRIVATE_CHAT_AI=false

# AI behavior
BOT_SYSTEM_PROMPT=You are a helpful customer support assistant for a Telegram Business account. Answer naturally, accurately and concisely. Reply in the same language as the customer unless the customer asks for another language. Never claim that a human has done something unless the conversation explicitly confirms it.
MAX_HISTORY_MESSAGES=12
MAX_REPLY_LENGTH=3500
TYPING_DELAY_MS=700
RATE_LIMIT_PER_MINUTE=20
SUGGESTION_TTL_MINUTES=60

# AI provider 1 (OpenAI-compatible)
AI_PROVIDER_1_ENABLED=false
AI_PROVIDER_1_NAME=provider1
AI_PROVIDER_1_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_1_API_KEY=
AI_PROVIDER_1_MODEL=

# AI provider 2 (OpenAI-compatible)
AI_PROVIDER_2_ENABLED=false
AI_PROVIDER_2_NAME=provider2
AI_PROVIDER_2_BASE_URL=
AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=

# AI provider 3 (OpenAI-compatible)
AI_PROVIDER_3_ENABLED=false
AI_PROVIDER_3_NAME=provider3
AI_PROVIDER_3_BASE_URL=
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=

LOG_LEVEL=info
DATA_DIR=/app/data
